# ── Secrets ──────────────────────────────────────────────────────────────────
# Note: anything in a Vite .env prefixed VITE_ is bundled into the JavaScript
# and visible to anyone using the site. Never put a real secret there.
.env
.env.*
!.env.example

# ── Dependencies and build output ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
.vite/

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
